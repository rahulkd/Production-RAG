# Environment variables - never commit credentials
.env
.env.*
!.env.example
!.env.test.example

# Evaluation harness run artifacts. The corpus manifest IS committed (it is the
# frozen corpus definition); logs and per-run results are not.
src/evaluation/logs/
src/evaluation/results/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.ruff_cache/

# Logs
*.log
logs/

# Downloaded arXiv PDF cache (runtime artifact, written by Airflow as UID 50000)
data/arxiv_pdfs/
# Evaluation corpus PDF cache (host-owned, written by src/evaluation/corpus/build.py)
data/eval_pdfs/
# Safety net: ARXIV__PDF_CACHE_DIR is a relative path, so a run from the wrong
# working directory drops PDFs into a nested data/arxiv_pdfs/ that the anchored
# rules above do not cover. Unanchored so it matches at any depth.
**/arxiv_pdfs/
**/eval_pdfs/

# Node / Next.js frontend
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local reference clone of the assistant-ui monorepo (~180 MB, not part of this
# project). Anchored to the repo root so it does not also match the vendored
# frontend/components/assistant-ui/ directory.
/assistant-ui/
