# Referenced by [tool.pytest.ini_options] env_files in pyproject.toml.
# Copy to .env.test (gitignored) before running the test suite.
#
# Tests under tests/ are hermetic — no OpenSearch, Postgres, Bedrock, Jina, or
# arXiv calls — so these values only need to exist, not to be valid. Anything
# requiring live services lives under src/evaluation and is run via its CLIs.

ENVIRONMENT=development
DEBUG=true

POSTGRES_DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db_test

OPENSEARCH__HOST=http://localhost:9200
OPENSEARCH__INDEX_NAME=arxiv-papers-test

JINA_API_KEY=test-key-not-used
AWS_BEARER_TOKEN_BEDROCK=test-token-not-used
